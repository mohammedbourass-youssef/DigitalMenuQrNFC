# Root domain used to resolve the tenant from the hostname.
# The tenant slug is the single host label in front of this domain,
# e.g. "snackme" for http://snackme.localhost
VITE_BASE_DOMAIN=yourdomain.com

# Base URL of the tenant API. In development this is the local ASP.NET Core
# backend (Kestrel HTTPS), e.g. https://localhost:7194.
VITE_API_URL=https://api.yourdomain.com

# Fallback tenant slug used in development only (never shipped to production).
# Useful when running on plain http://localhost.
VITE_DEV_TENANT=

# When "true", the app serves data from the built-in mock (src/data.ts)
# and skips all network calls. Set to "false" to hit the real API.
VITE_USE_MOCK=false

# Development-only mock for order tracking, used when the kitchen backend is not
# running. It speaks the same contract as GET /api/tenant/Order/{id}/Line,
# including the numeric step enum and the ORDER_NOT_FOUND error code, so the app
# behaves identically either way. Leave unset (or "false") for the real backend.
VITE_MOCK_ORDER_LINE=false