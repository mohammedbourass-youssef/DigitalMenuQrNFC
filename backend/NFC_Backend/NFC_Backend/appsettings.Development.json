{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SmartMenuDb": "${CONNECTION_STRINGS__SMARTMENUDB}",
    "Redis": "${CONNECTION_STRINGS__REDIS}"
  },
  "Minio": {
    "Endpoint": "${MINIO_ENDPOINT}",
    "AccessKey": "${MINIO_ACCESS_KEY}",
    "SecretKey": "${MINIO_SECRET_KEY}",
    "BucketName": "${MINIO_BUCKET_NAME}",
    "UseSsl": "${MINIO_USE_SSL}"
  },
  "AppSettings": {
    "BaseDomain": "${APP_SETTINGS__BASE_DOMAIN}",
    "UseHttps": "${APP_SETTINGS__USE_HTTPS}",
    "DefaultPort": "${APP_SETTINGS__DEFAULT_PORT}",
    "UseRedis": "${APP_SETTINGS__USE_REDIS}"
  },
  "Variable": {
    "FreeTrialDays": "${VARIABLE__FREE_TRIAL_DAYS}",
    "SessionExpirationHours": "${VARIABLE__SESSION_EXPIRATION_HOURS}"
  },
  "ExchangeRateApi": {
    "ApiKey": "${EXCHANGE_RATE_API_KEY}"
  },
  "profiles": {
    "http": {
      "applicationUrl": "${PROFILES__HTTP__APPLICATION_URL}"
    }
  },
  "GmailSettings": {
    "SenderEmail": "${GMAIL_SETTINGS__SENDER_EMAIL}",
    "SenderName": "${GMAIL_SETTINGS__SENDER_NAME}",
    "AppPassword": "${GMAIL_SETTINGS__APP_PASSWORD}",
    "Host": "${GMAIL_SETTINGS__HOST}",
    "Port": "${GMAIL_SETTINGS__PORT}"
  },
  "AzureTranslator": {
    "ApiKey": "${AZURE_TRANSLATOR_API_KEY}",
    "Region": "${AZURE_TRANSLATOR_REGION}",
    "Endpoint": "${AZURE_TRANSLATOR_ENDPOINT}"
  },
  "LibreTranslate": {
    "Endpoint": "${LIBRETRANSLATE_ENDPOINT}"
  },
  "Gemini": {
    "ApiKey": "${GEMINI_API_KEY}",
    "Model": "${GEMINI_MODEL}"
  }
}
