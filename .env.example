# ---------------------------------------------------------------
# Smart Menu NFC - Environment variables example
# Copy this file to .env and fill in your own values before
# running `docker compose up -d`.
# ---------------------------------------------------------------

# ---- PostgreSQL ----
POSTGRES_DB=eByte_Software
POSTGRES_USER=eByte_Software_user
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432

# Backend connection settings (container-to-container PostgreSQL connection)
DB_NAME=eByte_Software
DB_USER=eByte_Software_user
DB_PASSWORD=change_me_postgres_password
DB_PORT=5432

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin_password

# ---- MinIO ----
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET_NAME=smart-menu-nfc
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
SEQ_SERVER_URL=http://seq:5341

# ---- Redis ----
USE_REDIS=true
REDIS_CONNECTION_STRING=redis:6379,abortConnect=false

#--------------Vite Environment Variables----------------
VITE_API_URL=/api
VITE_BASE_DOMAIN=localhost
VITE_DEV_TENANT=snackme
VITE_USE_MOCK=false
VITE_MOCK_ORDER_LINE=false

#-----------------backend------------------------------------
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_ISSUER=jwt-issuer
JWT_AUDIENCE=jwt-audience
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7
BASE_DOMAIN=localhost

EXCHANGE_RATE_API_KEY=change_me_exchange_rate_api_key
GMAIL_APP_PASSWORD=change_me_gmail_app_password
GMAIL_SENDER_EMAIL=sender@example.com
GMAIL_SENDERNAME="NFC Backend"
GMAIL_PORT=587
GMAIL_HOST=smtp.gmail.com
AZURE_TRANSLATOR_API_KEY=change_me_azure_translator_key
GEMINI_API_KEY=change_me_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
AZURE_TRANSLATOR_REGION=eastus
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
FREE_TRIAL_DAYS=30
SESSION_EXPIRATION_HOURS=24
DEFAULT_PORT=500

BACKEND_URL=https://localhost:7194

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
